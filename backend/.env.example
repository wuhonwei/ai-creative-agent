# DeepSeek API 配置
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 可用模型：deepseek-v4-pro (推荐，创作质量优先) | deepseek-v4-flash (快速版) | deepseek-chat (V3旧版)
DEEPSEEK_MODEL=deepseek-v4-pro

# 通义万相图片生成配置
TONGYI_API_KEY=sk-your-tongyi-key-here
TONGYI_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
TONGYI_MODEL=wanx2.6-t2i
# 图片生成默认参数
IMAGE_WIDTH=1024
IMAGE_HEIGHT=1024
IMAGE_STYLE=anime

# 可灵（Kling）图生视频配置。鉴权用 AccessKey + SecretKey 签 JWT。
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-v2-6
KLING_IMAGE_MODEL=kling-v2-1
KLING_IMAGE_ASPECT_RATIO=16:9
VIDEO_DURATION=5
VIDEO_MODE=pro
VIDEO_SOUND=on

# ffmpeg / ffprobe 可执行文件完整路径（本机不在 PATH，需写完整路径）
FFMPEG_PATH=D:\下载\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=D:\下载\ffmpeg\bin\ffprobe.exe

# 数据库文件路径（相对 backend 目录）
DATABASE_URL=sqlite:///./creative_agent.db

# 生成参数
LLM_TEMPERATURE=0.85
# 每章约 2000 字（约 3000-4000 tokens），max_tokens 留足余量防止截断
LLM_MAX_TOKENS=6144
# 每章目标字数（软约束，prompt 会引导模型控制在 ±15% 区间）
CHAPTER_TARGET_WORDS=2000

# humanizer 去 AI 味：生成 Prompt 预防 + 生成后润色（默认均开启）
ENABLE_HUMANIZER_PREVENTION=true
ENABLE_HUMANIZER_POST=true

# 上下文预算（字符数，约等于中文字数）：
# 控制喂给模型的"最近全文章节"占用的上下文上限，超出部分依赖压缩摘要
RECENT_CHAPTERS_CHAR_BUDGET=12000

# 允许的前端来源（CORS）
FRONTEND_ORIGIN=http://localhost:5173
